---
import Icon from './Icon.astro';
import { videos, social } from '../lib/data.js';
import { cleanTitle } from '../lib/youtube.js';

const shorts = videos.shorts;
---

{
  shorts.length > 0 && (
    <section class="section shorts" id="shorts" aria-labelledby="shorts-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="section-title" id="shorts-title">
            Shorts <span class="accent">y TikTok</span>
          </h2>
          <div class="shorts__actions">
            <button class="rail-btn" type="button" data-dir="-1" aria-label="Shorts anteriores">
              <Icon name="left" />
            </button>
            <button class="rail-btn" type="button" data-dir="1" aria-label="Más Shorts">
              <Icon name="right" />
            </button>
            <a class="btn" href={social('tiktok')?.url} rel="noopener">
              <Icon name="tiktok" /> TikTok
            </a>
          </div>
        </div>
      </div>

      <ul class="rail" role="list">
        {shorts.map((s) => (
          <li class="short">
            <a href={s.url} rel="noopener">
              <img
                src={`https://i.ytimg.com/vi/${s.id}/oar2.jpg`}
                alt=""
                width="405"
                height="720"
                loading="lazy"
              />
              <span class="short__title">{cleanTitle(s.title)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .shorts {
    background: linear-gradient(180deg, var(--ink-0), var(--ink-1) 40%, var(--ink-0));
  }
  .shorts__actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .rail-btn {
    display: none;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border: 2px solid var(--line);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .rail-btn:hover {
    border-color: var(--blue);
    background: rgb(0 131 255 / 0.16);
  }
  @media (hover: hover) and (min-width: 48rem) {
    .rail-btn {
      display: grid;
    }
  }

  .rail {
    --pad: max(var(--gutter), (100% - var(--max)) / 2);
    list-style: none;
    margin: 0;
    padding: 0 var(--pad) 1rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(11rem, 42vw, 15rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad);
    scrollbar-width: thin;
  }
  .short {
    scroll-snap-align: start;
  }
  .short a {
    display: block;
    position: relative;
    text-decoration: none;
    overflow: hidden;
    background: var(--ink-2);
  }
  .short img {
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }
  .short a:hover img {
    transform: scale(1.04);
  }
  .short a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgb(4 6 12 / 0.92));
    pointer-events: none;
  }
  .short__title {
    position: absolute;
    z-index: 1;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.85rem;
    font-weight: 800;
    font-stretch: 85%;
    line-height: 1.15;
    font-size: 1.0625rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('.rail');
  document.querySelectorAll<HTMLButtonElement>('.rail-btn').forEach((btn) =>
    btn.addEventListener('click', () => {
      rail?.scrollBy({ left: Number(btn.dataset.dir) * rail.clientWidth * 0.8, behavior: 'smooth' });
    }),
  );
</script>
