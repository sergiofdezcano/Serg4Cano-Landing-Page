---
// Brand marks come from simple-icons; UI glyphs are Lucide paths (24px, 2px stroke).
import { siYoutube, siTwitch, siKick, siTiktok, siX, siInstagram, siDiscord } from 'simple-icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;

const brands: Record<string, { path: string }> = {
  youtube: siYoutube,
  twitch: siTwitch,
  kick: siKick,
  tiktok: siTiktok,
  x: siX,
  instagram: siInstagram,
  discord: siDiscord,
};

const ui: Record<string, string> = {
  arrow: '<path d="M7 17 17 7"/><path d="M7 7h10v10"/>',
  play: '<path d="M6 4.5v15l13-7.5z" fill="currentColor"/>',
  copy: '<rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  left: '<path d="m15 18-6-6 6-6"/>',
  right: '<path d="m9 18 6-6-6-6"/>',
  heart: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M12 14v4"/><path d="M10 16h4"/>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};
const brand = brands[name];
---

{
  brand ? (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={brand.path} />
    </svg>
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={ui[name]}
    />
  )
}
