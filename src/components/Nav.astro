---
interface Props {
  links: { href: string; label: string }[];
}
const { links } = Astro.props;
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="#top" aria-label="Serg4Cano, volver arriba">S<span>4</span>C</a>
    <nav aria-label="Secciones">
      <ul class="nav__links">
        {
          links.map((l) => (
            <li>
              <a class="label" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(4 6 12 / 0.94);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 3.75rem;
  }
  .nav__brand {
    flex: none;
    font-weight: 900;
    font-stretch: 110%;
    font-size: 1.375rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .nav__brand span {
    color: var(--blue);
  }
  nav {
    min-width: 0;
    margin-left: auto;
  }
  .nav__links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }
  .nav__links::-webkit-scrollbar {
    display: none;
  }
  .nav__links a {
    display: block;
    padding: 0.55rem 0.7rem;
    font-size: 1.0625rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .nav__links a:hover,
  .nav__links a[aria-current='true'] {
    color: var(--text);
    box-shadow: inset 0 -3px 0 var(--blue);
  }
  @media (min-width: 52rem) {
    .nav__links {
      mask-image: none;
    }
  }
</style>

<script>
  // Highlight the section currently in view
  const list = document.querySelector<HTMLElement>('.nav__links');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a')];
  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        const current = byId.get(e.target.id);
        current?.setAttribute('aria-current', 'true');
        // On phones the links scroll sideways: keep the current one in sight
        if (current && list && list.scrollWidth > list.clientWidth) {
          const x = current.getBoundingClientRect().left - list.getBoundingClientRect().left + list.scrollLeft;
          const left = x - (list.clientWidth - current.offsetWidth) / 2;
          list.scrollTo({ left, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  byId.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
</script>
