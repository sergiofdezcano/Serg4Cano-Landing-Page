---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Videos from '../components/Videos.astro';
import Shorts from '../components/Shorts.astro';
import Live from '../components/Live.astro';
import Setup from '../components/Setup.astro';
import Recommendations from '../components/Recommendations.astro';
import Deals from '../components/Deals.astro';
import Tweets from '../components/Tweets.astro';
import Contact from '../components/Contact.astro';
import { profile, setup, deals, steamOffers, tweets, videos, recommendations } from '../lib/data.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = Astro.site ? new URL(base, Astro.site).href : base;
const title = 'Serg4Cano · Battlefield 6, directos y vídeos';
const description = `${profile.bio} Directos ${profile.schedule.label} a las ${profile.schedule.time}.`;

// Navigation only lists sections that actually render
const links = [
  videos.videos.length && { href: '#videos', label: 'Vídeos' },
  videos.shorts.length && { href: '#shorts', label: 'Shorts' },
  { href: '#directos', label: 'Directos' },
  setup.length && { href: '#setup', label: 'Setup' },
  recommendations.length && { href: '#recomendaciones', label: 'Recomendaciones' },
  (deals.length || steamOffers.offers.length) && { href: '#descuentos', label: 'Descuentos' },
  tweets.length && { href: '#tweets', label: 'Tweets' },
  { href: '#contacto', label: 'Contacto' },
].filter(Boolean) as { href: string; label: string }[];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#04060c" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={site} />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}img/og.jpg`} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@serg4Cano" />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Nav links={links} />
    <main id="main">
      <Hero />
      <div class="stripes" aria-hidden="true"></div>
      <Videos />
      <Shorts />
      <Live />
      <Setup />
      <Recommendations />
      <Deals />
      <Tweets />
    </main>
    <Contact />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 200;
    padding: 0.75rem 1rem;
    background: var(--blue-fill);
    color: #fff;
    font-weight: 800;
  }
  .skip:focus {
    top: 1rem;
  }
</style>
